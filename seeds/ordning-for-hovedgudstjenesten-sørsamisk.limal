{
	"liturgiFormat": 1,
	"kind": "template",
	"data": {
		"id": "ordning-for-hovedgudstjenesten-sørsamisk",
		"name": "Ordning for hovedgudstjenesten (Sørsamisk)",
		"malForm": "Sørsamisk",
		"liturgiType": "gudstjeneste",
		"kanGudstjeneste": true,
		"sections": [
			{
				"title": "Tjåanghkoe",
				"items": [
					{
						"id": "i-mwrtxqt8-0",
						"type": "tekst",
						"heading": "",
						"instr": "@NOTAT Gærhkoen bealloeh tjuejieh",
						"text": "1 Jupmele-gaagkestimmien åvtelen\nAlmetjh maehtieh gærhkose båetedh aerebe goh jupmele-gaagkestimmie aalka, sjeavohth tjahkasjidh, tjoevkesem båaltajehtedh jïh rohkelidh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt8-1",
						"type": "tekst",
						"heading": "Daelie jallh gåalmede lïhtsen (3 Heelsege) mænnagan",
						"instr": "@NOTAT Klahke-liturge jallh liturge jupmele-gaagkestimmien bïjre bæjjohte.\n@NOTAT Sjeavohts boelhketje.\n@NOTAT Bealloe tjuaja golmen aejkien",
						"text": "Bæjjoehtimmie naemhtie galhkoe:\n{{r}}KL/L |{{/r}} Dellie edtjebe Jupmelen uvte sjeavohth årrodh.\n\nJeenemasth gosse åålmege edtja tjåadtjodh, dellie naestie (*) tjaalasovveme.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-2",
						"type": "tekst",
						"heading": "* 2 Aalkoe-saalme",
						"instr": "",
						"text": "Laavlome jallh musihke mij sjeahta, maahta preludijumine årrodh.\nProsesjovne båata gosse preludijume jïh/jallh gosse aalkoe-saalme aalka. Dïhte gie prosesjovne-kroessem guadta, åvte-gietjesne vaadtsa, jïh dellie dah båetieh gïeh tjoevkem, laavkome-tjaetsiem, laejpieh jïh vijnem jïh aejlies gærjam guedtieh.\nÅålmege tjåådtje gosse prosesjovne båata jïh gosse aalkoe-saalmem lååvle jïh Heelsegen mearan.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-3",
						"type": "tekst",
						"heading": "* 3 Heelsege",
						"instr": "",
						"text": "Gosse laavkome, dellie voestes jallh mubpie rohkelasse veeljesåvva. Jïh dellie liturge maahta jiehtedh: Gieries åålmege:\n\n{{r}}L |{{/r}} Aarmoe jïh raeffie Jupmielistie, mijjen Aehtjeste,\njïh Åejvie Jeesus Kristusistie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-4",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Mijjen Åejvie Jeesus Kristusen aarmoe jïh Jupmelen gieriesvoete jïh Aejlies Voejkenen ektievoete dijjine årroeh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-5",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Aehtjien () Baernien jïh Aejlies Voejkenen nommesne.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-6",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Aehtjien () Baernien jïh Aejlies Voejkenen nommesne: Mijjen sjugniedæjja, lutniestæjja jïh hïegke-vedtije.\n\nÅålmege tjihkede.\nJis liturge jallh klahke-liturge ij leah aerebe gyrhkesjimmien bïjre bæjjoehtamme, dellie maahta daelie bæjjoehtidh.\n\n4 Aalkoe-rohkelasse\nVuartesjh Aalkoe-rohkelassh jïh veeljh dejstie.\n\n{{r}}KL |{{/r}} Rohkelibie.\n\nBIBELREF | jallh 1\n{{r}}KL |{{/r}} Jupmele, dov aejlies gåatan libie tjaangeme dåastoehtidh dam maam datne sïjhth mijjese vedtedh.\nRïhpesth mijjen vaajmojde guktie mijjen jaahkoe dutnjien orreståvva.\n\nBIBELREF | jallh 2\n{{r}}KL |{{/r}} Aejlies Jupmele, dov ååredæjjan uvte libie tjåanghkenamme dov gieriesvoetem jïh rïektesvoetem dåastoehtidh.\nRaajh dov Voejkenem mijjese, jïh rïhpesth mijjen vaajmojde guktie dåastoehtibie dam maam datne mijjese vadtah. Baajh dov baakoem mijjen vaajmose sjïdtedh guktie Kristuse mijjesne jeala, jïh mijjieh datnine aktanibie jïh datnem gaajhkine dïenesjibie.\n\nBIBELREF | jallh 3\n{{r}}KL |{{/r}} Buerie Jupmele, datne guhte hïegkem gaajhkide vadteme mah jielieh, datnem heevehtibie eatnemen tjaebpiesvoeten åvteste\njïh gaajhki åvteste mah vuesiehtieh datne boerehke.\nDov ååredæjjan uvte rohkelibie: Rïhpesth mijjen bieljide guktie goltelibie gosse soptsesth. Vedtieh mijjese vaajmoeh mah datnem dov buerievoeten åvteste gijhtieh. Vedtieh njoektjemh jïh gïeth mah dov åavtoej bïjre vïhnesjieh.\n\n{{r}}KL |{{/r}} Jupmele, rohkelibie.\n{{r}}G |{{/r}} Aamen.\n\n5 Sådtoe-boejhkesjimmie\nSådtoe-boejhkesjimmie daelie jallh goh lïhtse 17 Åålmegen rohkelassh.\n\nSådtoe-boejhkesjimmie naemhtie aalka:\n{{r}}L |{{/r}} Jupmelen uvte boelvestibie jïh mijjen sådtojde boejhkesjibie.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-7",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Jupmelen uvte boelvestibie jïh Jupmelem birrebe edtja sådtojde mijjeste luejhtedh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-8",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Mijjen sådtojde boejhkesjibie juktie leajhtadibie Jupmele åårmege lea.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-9",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Sjeavohts boelhketje",
						"text": "{{r}}L |{{/r}} Jupmelem birrebe edtja sådtojde mijjeste luejhtedh juktie leajhtadibie Jupmele åårmege lea.\n\nLiturge boelveste mearan sådtojde boejhkesje jïh sjeavohth lea. Åålmege aaj maahta boelvestidh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-10",
						"type": "tekst",
						"heading": "jallh a",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, aarmodh mannem!",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-11",
						"type": "tekst",
						"heading": "Dov vööste leam sådtoedamme jïh mov lïhkesadtjem beahteme",
						"instr": "",
						"text": "– dejnie maam ussjedamme jïh soptsestamme jïh dorjeme jïh dejnie maam im leah dorjeme.\nLuejhtieh mov sådtojde manneste Jeesus Kristusen gielhtie.\nOrresth mov vaajmoem jïh vedtieh faamoem orre jieliemasse dov Aejlies Voejkeninie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-12",
						"type": "tekst",
						"heading": "jallh b",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, aarmodh mannem!\nLuejhtieh sådtojde manneste Jeesus Kristusen gielhtie.\nOrresth mov vaajmoem jïh vedtieh faamoem orre jieliemasse dov Aejlies Voejkeninie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-13",
						"type": "tekst",
						"heading": "jallh c",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, datne mijjem damth jïh eahtsah.\nDatne sïjhth mijjieh edtjebe sinsitniem jïh eatnemem hoksedh.\nDaejrebe datnem libie beahteme jïh dov vuestie meadteme.\nLuejhtieh sådtojde mijjeste jïh viehkehth mijjem Jeesusen gielhtie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-14",
						"type": "tekst",
						"heading": "jallh d",
						"instr": "",
						"text": "{{r}}G |{{/r}} Aejlies Jupmele, mijjen sjugniedæjja, vuartesjh mijjem aarmojne.\nMijjieh datnem jïh dov stillemidie meadteme.\nLuejhtieh mijjen sådtojde mijjeste Jeesus Kristusen gielhtie.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-15",
						"type": "tekst",
						"heading": "Baajh mijjem datnem dïenesjidh jïh sjugniedimmiem vaarjelidh",
						"instr": "",
						"text": "jïh lïhkesadtjem gieriesvoetine gaavnesjidh.\n\nÅålmege maahta aaj 1977-njoelkedassen sådtoe-boejhkesjimmiem utnedh.\nAejlies Jupmele, elmierïjhken Aehtjie, vuartesjh munnjien aarmolesvoetesne. Sådteres almetje leam gie datnem meadteme åssjalommesigujmie, baakoejgujmie, dahkoegujmie jïh vaajmosne damtem dam mij nåake.\nArhph mannine Jeesus Kristusen gielhtie.\nLuejhtieh sådtojde manneste jïh viehkehth mannem datneste våavkasjidhjïh ajve datnem iehtsedh.\n\nÅålmege muvhtene maahta jeatjah boejhkesjimmiem boejhkesjidh goh akte daejstie mah daesnie leah.\n\nLiturge maahta daelie dååjvehtasse-baakoem lohkedh.\n{{r}}L |{{/r}} Aejlies gærjesne tjaalasovveme: Gosse mijjen sådtojde boejhkesjibie, dellie Jupmele stynkehke jïh rïektesvoetesne guktie mijjen sådtojde luajhta jïh mijjem reejnie gaajhkijste mah eah staaran leah.\nBIBELREF | 1 Jåhha 1,9\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-16",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Laavkome jeenemasth aejkien daelie.\n@NOTAT Vuartesjh Biejjien rohkelassh",
						"text": "{{r}}L |{{/r}} Dan jïlle goh elmien jissie dan faamohke Åejvien aarmoe dejtie gïeh jïjtjemse goltelieh. Dan guhkie goh luvlede jallese, dan gåhkese mijjen sådtojde voelkehte. Saalm 103,11-12\n\n6 Aanoehtimmie KYRIJE jïh 7 Heevehtimmie GLORIJA\nKyrije jïh Glorija lååvlesuvvieh\n\n{{r}}G |{{/r}} Kyrije eelejsån, Jupmel-aehtjie, aarmodh. Kriste eelejsån, Kristuse åejvie, aarmodh. Kyrije eelejsån, Aejlies Voejkene, aarmodh.\n\n{{r}}L/KL |{{/r}} Earoe Jupmielasse jallatjommesisnie\nÅå| jïh eatnamasse raeffie, almetjidie guhth Jupmelen lyjhkedisnie. Heevehtibie, gyjhtelibie, rohkelibie, earoehtibie. Aamen.\n\n8 Biejjien rohkelasse\nBiejjien rohkelasse maahta heajhtasovvedh. Liturge maahta rohkelassem laavlodh jallh lohkedh.\n\nRohkelasse naemhtie aalka:\n{{r}}L |{{/r}} Rohkelibie.\n\nRohkelasse naemhtie galhkoe:\nÅå | Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					}
				]
			},
			{
				"title": "Jupmelen baakoe",
				"items": [
					{
						"id": "i-mwrtxqt9-17",
						"type": "tekst",
						"heading": "",
						"instr": "",
						"text": "Muvhtene sjeahta göökte bijpele-teksth lohkedh jïh muvhtene aktem tekstem lohkedh. Dellie låhkede lïhtse (10 Saalme) maahta heajhtasovvedh. Åålmege tjåådtje gosse vaentjele lohkesåvva, jïh tjahkesje gosse mubpieh bijpele-teksth lohkesuvvieh.\n\n{{r}}L/KL |{{/r}} Jupmelen baakoem goltelibie.\n\n9 Voestes lohkeme\nBåeries testamenten luvhtie\n{{r}}KL |{{/r}} Naemhtie ….. tjaalasovveme.\n\nLohkeme naemhtie galhkoe:\n{{r}}KL |{{/r}} Naemhtie Jupmelen baakoe.\n\n10 Saalme\nSaalme jallh laavlome laavlome-krirreste jallh sjeavohts boelhketjh lohkemen gaskoeh.\n\n11 Mubpie lohkeme\nLohkeme orre testamenten luvhtie, mohte ij vaentjeli luvhtie.\n\n{{r}}KL |{{/r}} Naemhtie ….. tjaalasovveme.\n\nLohkeme naemhtie galhkoe:\n{{r}}KL |{{/r}} Naemhtie Jupmelen baakoe.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-18",
						"type": "tekst",
						"heading": "*12 Vaentjele",
						"instr": "@NOTAT Halleluja\n@NOTAT Vaentjele-lohkeme\n@NOTAT Response",
						"text": "Aerebe goh vaentjele lohkesåvva, åålmege halleluja-saalmem jallh åenehks saalmem halleluja-vïersine lååvle.\nVaentjele-prosesjovne gosse sjeahta. Åålmege tjåådtje jïh lååvle gosse prosesjovne båata aejlies gærjine jïh tjoevkine.\n\n{{r}}L/KL |{{/r}} Naemhtie …-n vaentjielisnie tjaalasovveme:\n\nLohkeme naemhtie galhkoe:\n{{r}}L/KL |{{/r}} Naemhtie aejlies vaentjele.\n\nÅålmege maahta halleluja-saalmem jallh åenehks saalmem halleluja-vïersine vihth lååvledh.\n\n13 Prïejhke\n\nPrïejhke maahta naemhtie galhkedh:\n{{r}}L |{{/r}} Earoe Jupmel-aahtjan, Baarnan jïh Aejlies Voejkenasse,gie lij, lea jïh edtja årrodh aajnehke saetnies Jupmele ihkuvistie ihkuvasse.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-19",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Earoe Jupmel-aahtjan, Baarnan jïh Aejlies Voejkenasse: Mijjen sjugniedæjja, lutniestæjja jïh hïegkevedtije.\n\nDellie åenehks saalme, musihke jallh sjeavohts boelhketje.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-20",
						"type": "tekst",
						"heading": "*14 Jaahkoe-bæjhkoehtimmie CREDO",
						"instr": "",
						"text": "Gosse laavkome, åålmege maahta dellie aejlies jaahkoem bæjhkoehtidh.\n\n{{r}}KL/L |{{/r}} Bæjhkoehtibie mijjen aejlies jaahkoem.\n{{r}}G |{{/r}} Manne Jupmel-aahtjan jaahkam, faamohkommeselmien jïh eatnemen sjugniedæjjese.Manne Jeesus Kristusasse jaahkam,Jupmelen aajnehke Baarnan, mijjen åajvangie Aejlies Voejkeninie åedtjine sjïdti, Maarja nïejteste reakadi,Pontius Pilatusen baelien njåvtasovvi, kroessese noeresovvi,\njeemi jïh kroeptese bïejesovvi, våålese jaemede-rïjhkese vöölki,gåalmeden biejjien jaemiedistie tjuedtjieli, bæjjese alman vöölki,Jupmelen, faamohkommes Aehtjien, åelkies bielesne tjahkan,gubpede vihth edtja bååstide båetedh, jielije jïh åemie almetjidie dööpmedh.Manne Aejlies Voejkenasse jaahkam, gærhkoen aejlies ektievoetese,aejlies almetji tjåanghkenæmman, sådtoej luejhtiemasse,åedtjien tjuedtjielæmman jïh ihkuven jieliemasse.Aamen. Aposteli jaahkoe-bæjhkoehtimmie\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-21",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}G |{{/r}} Aajnehke Jupmielasse jaehkebe, faamohkommes Aahtjan, gie elmiem jïh eatnemem sjugniedamme jïh gaajhkem maam vuejnebe jïh maam ibie vuejnieh.\nAajnehke Åajvan, Jeesus Kristusasse, Jupmelen aajnehke Baarnan jaehkebe, gie aejkiej åvteli Aehtjeste reakadi, gie Jupmele Jupmielistie lea, tjoevke tjoevkeste, saetnies Jupmele saetnies Jupmielistie, reakadamme, ij sjugniedovvemejïh goh Jupmel-aehtjie lea. Altasinie gaajhke sjugniedovveme.Mijjen gaavhtan jïh mijjen gorredimmien gaavhtan elmeste våålese bööti,Aejlies Voejkeninie jïh Maarja nïejteste sïejhme almetjinie reakadi.Pontius Pilatusen baelien noeresovvi, njåvtasovvi jïh kroeptese bïejesovvi, gåalmeden biejjien tjuedtjieli guktie tjaalasovveme, bæjjese alman vöölki, Jupmel-aehtjien åelkies bielesne tjahkan, gubpede vihth hearlohkevoetesne bååstide båata jielije jïh åemie almetjidie dööpmedh. Altese rïjhke ihkuven aajkan.\nAejlies Voejkenasse jaehkebe, gie Åejvine lea jïh jealadahta. Aehtjeste jïh Baerneste lea, Aehtjine jïh Baernine aktine heevehtåvva jïh earoehtåvva\njïh baajeme profeetide jïjtse bïjre soptsestidh. Aajnehke, aejlies, sïejhme jïh apostolihke gærhkose jaehkebe.Aajnehke laavkomem sådtoej luejhtiemasse bæjhkoehtibie.Åedtjien tjuedtjielæmman jïh jielemem båetije veartanisnie vuertebe.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-22",
						"type": "tekst",
						"heading": "Aamen. Nikenen jaahkoe-bæjhkoehtimmie",
						"instr": "",
						"text": "15 Saalme\nSaalme daelie jallh lïhtse 13 Prïejhken jïh lïhtse 14 Jaahkoe-bæjhkoehtimmien giske.\n\n16 Bïevnesh\nBïevnesh daelie jallh gosse sjeahta jïh guktie sjeahta.\n\n17 Sådtoe-boejhkesjimmie\nDaelie jallh goh lïhtse 5 Sådtoe-boejhkesjimmie.\n\nLiturge maahta jiehtedh:\n{{r}}L |{{/r}} Mijjen Åejvie Jeesus Kristuse jeahta: Iehtsieh Åejviem, jïjtjedh Jupmelem, abpe jïjtjedh vaajmojne, abpe jïjtjedh sealojne jïh abpe jïjtjedh jiermine! Daate stööremes jïh voestes båvroe. Mubpie båvroe seamma stoere: Iehtsieh jïjtjedh lïhkesadtjem guktie jïjtjemdh eahtsah! Meehte 22, 37–39\n\nSådtoe-boejhkesjimmie naemhtie aalka:\n{{r}}L |{{/r}} Jupmelen uvte boelvestibie jïh mijjen sådtojde boejhkesjibie.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-23",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Boelvestibie jïh Jupmelem birrebe edtja sådtojde mijjeste luejhtedh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-24",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Mijjen sådtojde boejhkesjibie juktie leajhtadibie Jupmele åårmege lea.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-25",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Sjeavohts boelhketje",
						"text": "{{r}}L |{{/r}} Jupmelem birrebe edtja sådtojde mijjeste luejhtedh juktie leajhtadibie Jupmele åårmege lea.\n\nLiturge boelveste mearan sådtojde boejhkesje jïh sjeavohth lea. Åålmege aaj maahta boelvestidh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-26",
						"type": "tekst",
						"heading": "jallh a",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, aarmodh mannem!",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-27",
						"type": "tekst",
						"heading": "Dov vööste leam sådtoedamme jïh mov lïhkesadtjem beahteme",
						"instr": "",
						"text": "– dejnie maam ussjedamme jïh soptsestamme jïh dorjeme jïh dejnie maam im leah dorjeme.\nLuejhtieh mov sådtojde manneste Jeesus Kristusen gielhtie.\nOrresth mov vaajmoem jïh vedtieh faamoem orre jieliemasse dov Aejlies Voejkeninie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-28",
						"type": "tekst",
						"heading": "jallh b",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, aarmodh mannem!\nLuejhtieh sådtojde manneste Jeesus Kristusen gielhtie.\nOrresth mov vaajmoem jïh vedtieh faamoem orre jieliemasse dov Aejlies Voejkeninie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-29",
						"type": "tekst",
						"heading": "jallh c",
						"instr": "",
						"text": "{{r}}G |{{/r}} Jupmele, datne mijjem damth jïh eahtsah.\nDatne sïjhth mijjieh edtjebe sinsitniem jïh eatnemem hoksedh.\nDaejrebe datnem libie beahteme jïh dov vuestie meadteme.\nLuejhtieh sådtojde mijjeste jïh viehkehth mijjem Jeesusen gielhtie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-30",
						"type": "tekst",
						"heading": "jallh d",
						"instr": "",
						"text": "{{r}}G |{{/r}} Aejlies Jupmele, mijjen sjugniedæjja, vuartesjh mijjem aarmojne.\nMijieh datnem jïh dov stillemidie meadteme.\nLuejhtieh mijjen sådtojde mijjeste Jeesus Kristusen gielhtie.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-31",
						"type": "tekst",
						"heading": "Baajh mijjem datnem dïenesjidh jïh sjugniedimmiem vaarjelidh",
						"instr": "",
						"text": "jïh lïhkesadtjem gieriesvoetine gaavnesjidh.\n\nÅålmege maahta aaj 1977-njoelkedassen sådtoe-boejhkesjimmiem utnedh.\nAejlies Jupmele, elmierïjhken Aehtjie, vuartesjh munnjien aarmolesvoetesne. Sådteres almetje leam gie datnem meadteme åssjalommesigujmie, baakoejgujmie, dahkoegujmie jïh vaajmosne damtem dam mij nåake.\nArhph mannine Jeesus Kristusen gielhtie.\nLuejhtieh sådtojde manneste jïh viehkehth mannem datneste våavkasjidhjïh ajve datnem iehtsedh.\n\nÅålmege muvhtene maahta jeatjah boejhkesjimmiem boejhkesjidh goh akte daejstie mah daesnie leah.\n\nLiturge maahta daelie dååjvehtasse-baakoem lohkedh.\n{{r}}L |{{/r}} Aejlies gærjesne tjaalasovveme: Gosse mijjen sådtojde boejhkesjibie, dellie Jupmele stynkehke jïh rïektesvoetesne guktie mijjen sådtojde luajhta jïh mijjem reejnie gaajhkijste mah eah staaran leah.\nBIBELREF | 1 Jåhha 1,9\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-32",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Vuartesjh rohkelasse-aamhtside, sjïere rohkelasse-vuekide, tjaaleldh rohkelasside jïh litanijidie.",
						"text": "{{r}}L |{{/r}} Dan jïlle goh elmien jissie dan faamohke Åejvien aarmoe dejtie gïeh satnem goltelieh. Dan guhkie goh luvlede jallese, dan gåhkese mijjen sådtojde voelkehte. Saalm 103,11-12\n\n18 Åålmegen rohkelassh\n\nÅålmege maahta rohkelassh tjaeledh jallh tjaalaldihkie rohkelassh utnedh. Eeremasth klahke-liturge rohkelasside låhka. Jeatjebh maehtieh rohkelassh lohkedh.\n\nFïerhte rohkele-boelhketje maahta naemhtie galhkedh:\n{{r}}KL/L |{{/r}} Jupmele, naemhtie rohkelibie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-33",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Åålmegen vaestiedimmie\n@NOTAT Mujhtebe dam/dejtie gie/gïeh sealadamme, jïh rohkelibie dej åvteste gïeh sorkeminie.",
						"text": "{{r}}KL/L |{{/r}} Jupmele, dam rohkelibie.\nDïhte gie rohkele, rohkelasside låhka jallh lååvle.\n\nÅålmege maahta rohkelassh tjaeledh. Daaj aamhtsi bïjre maehtieh tjaeledh:\nVeartenen almetji jïh nasjovni åvteste.\nMijjen nasjovnen jïh almetji åvteste.\nVeartenen gærhkoen jïh mijjen nasjovnen gærhkoen åvteste.\nMijjen åålmegen, fuelhkiej jïh tjïelten åvteste.\nDaaletje barkoen jïh tjoeperdimmien åvteste.\n\nRohkelasse maahta naemhtie aelkedh:\n{{r}}KL/L |{{/r}} Rohkelibie gærhkoen jïh veartenen åvteste.\n\nFïerhten rohkelassen mænngan åålmege maahta vaestiedimmiem lohkedh.\n\nBIBELREF | jallh 1\nÅå| Åejvie, govlh mijjen rohkelassh.\n\nBIBELREF | jallh 2\nÅå| Govlh mijjen rohkelassh. Govlh mijjen rohkelassh. Vaajt dov rïjhke båata, vaajt dov syjhtedassh sjædta. Govlh mijjen rohkelassh.\n\nBIBELREF | jallh 3\nÅå| Åejvie, govlh mijjen rohkelassh.\n\nBIBELREF | jallh 4\nÅå| Åejvie, mijjen Jupmele, govlh gosse rohkelibie. Minngemes rohkelassen mænngan gaajhkesh laavloeh Aamen.\nÅålmege maahta åålmegen rohkelassi mænngan dam/dejtie mujhtedh gie/gïeh juvlelgamme minngemes aejkien mænngan gosse åålmege tjåenghkesne lij.\n\n{{r}}KL/L |{{/r}} Tjuedtjielibie jïh mujhtebe dam gie/dejtie gïeh juvlelgamme minngemes aejkien mænngan gosse åålmege tjåenghkesne lij.\n\nÅålmege tjuedtjele. Klahke-liturge jallh liturge nommem/nommide låhka. Sjeavohts boelhketje.\n\n{{r}}KL/L |{{/r}} Jupmele, bïhkedh mijjem buejhkiehtidh man åenehke mijjen jieleme guktie vijsies vaajmoem åadtjobe. Saalm 90,12\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-34",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}KL/L |{{/r}} Jeesuse jeahta: «Manne leam tjuedtjielimmie jïh jielede. Dïhte gie munnjien jaahka, jeala jalhts jaama.» Jåhha 11,25\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-35",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT (N13: 872,5, T Svein Ellingsen)\n@NOTAT Gosse ij naan maalestahke leah, dellie liturge 24. lïhtsine (24 Saalme) lissehte.",
						"text": "Dellie daate rohkelasse jallh jeatjah rohkelasse lohkesåvva:\n{{r}}KL/L |{{/r}} Åårmegs Jupmele, soelkedh dejtie gïeh sorkeminie jïh årroeh dej luvnie båetije biejjide.\n\nÅålmege maahta vaestiedidh guktie vaestiedi gosse åålmege rohkeli.\n\n19 Åålmegen sjïele\nÅålmege maahta daelie sjïeledidh jallh gosse saalmem maalestahken åvtelen lååvle jallh gosse jupmele-gaagkesimmie galhkoe.\n\nGosse sjïeledamme, liturge maahta naemhtie rohkelidh:\n{{r}}L |{{/r}} Ihkuven Jupmele, dov lea eatneme jïh gaajhke mij desnie. Gaajhkem maam utnebe, dov lea, jïh destie sjïeledibie.\n{{r}}G |{{/r}} jallh L | Dåastohth mijjem jïh mijjen sjïelide Jeesusen gielhtie. Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					}
				]
			},
			{
				"title": "Aejlies maalestahke",
				"items": [
					{
						"id": "i-mwrtxqt9-36",
						"type": "tekst",
						"heading": "",
						"instr": "@NOTAT Saalme",
						"text": "20 Maalestahken åvtelen\nÅålmege maahta daelie sjïeledidh.\nLiturge laejpiem laejpie-gaerese beaja jïh vijnem gåasese gurkie.\n\nGosse sjïeledimmie galhkeme, dellie liturge rohkele:\n{{r}}L |{{/r}} Bueriesjugniedimmien Jupmele, dov lea eatneme jïh gaajhke mij daesnie. Gaajhke maam utnebe, dov lea. Destie mij dov lea, sjïeledibie. Ektedh dov åålmegem gïeh ovmessie sijjesne årroeminie jïh ovmessie gïelh soptsesteminie. Ektedh mijjem sinsitnine jïh Åejvie Jeesus Kristusinie guktie gernieh laejpesne aktanieh jïh vijnemuerjieh vijnesne aktanieh.\n{{r}}G |{{/r}} jallh L | Dåastohth mijjem jïh mijjen sjïelide Jeesusen gielhtie. Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqt9-37",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L |{{/r}} Ihkuven Jupmele, dov lea eatneme jïh gaajhke mij desnie. Gaajhkem maam utnebe, dov lea, jïh destie sjïeledibie.\n{{r}}G |{{/r}} jallh L | Dåastohth mijjem jïh mijjen sjïelide Jeesusen gielhtie. Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-38",
						"type": "tekst",
						"heading": "*21 Gyjhtelassh jïh rohkelassh",
						"instr": "",
						"text": "",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-39",
						"type": "tekst",
						"heading": "Maalestahken rohkelasse",
						"instr": "",
						"text": "",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-40",
						"type": "tekst",
						"heading": "Heelsege PREFASJOVNE",
						"instr": "@NOTAT Aalkove heevehtasse PREFASJOVNE\n@NOTAT Jupmelen golmelaaketje biejjieh",
						"text": "{{r}}L |{{/r}} lååvle jallh jeahta | Jupmele dijjine aktine.\nÅå tjuedtjele jïh lååvle | Jïh Jupmele datnine aaj.\n{{r}}L |{{/r}} Lutnjede vaajmojde!\nÅå lååvle| Jupmielasse vaajmojde lutnjebe.\n{{r}}L |{{/r}} Gijhtebe Jupmelem.\nÅå lååvle| Reaktoe hov nimhtie.\n\nLiturge aalteren vuestie jarkele jïh prefasjovnem lååvle jallh rohkele.\n\n{{r}}L |{{/r}} Saetniesvoetesne vyörtege jïh rïektes lea veaksahkommes Jupmelem, ihkuven Aehtjiem, gijhtedh Jeesus Kristusen, mijjen Åejvien gielhtie. Jeesusem seedtih veartenem gorredidh guktie mijjieh altese jaememen gielhtie maehtebe sådtojste luajhtasovvedh jïh altese tjuedtjielimmien gielhtie ihkuven jieledem åadtjodh. Eengkelh jïh åålmege elmierïjhkesne jïh eatnamisnie altese gielhtie dov hearlohkevoetem heevehtieh. Dejgujmie aktine mijjieh aaj datnem heevehtibie:\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-41",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Aejlies SANCTUS\n@NOTAT Maalestahken baakoeh VERBA\n@NOTAT Jaahkoen mysterijume",
						"text": "{{r}}L |{{/r}} Saetniesvoetesne vyörtege jïh rïektes lea veaksahkommes Jupmelem, ihkuven Aehtjiem, gijhtedh Jeesus Kristusen, mijjen Åejvien gielhtie. Jeesuse jielije laejpine lea gie elmierïjhkeste båata jïh veartanasse hïegkem vadta guktie dïhte gie altasasse båata, ij galkh nealkodh jïh fïereguhte gie altasasse jaahka, ij galkh gajhkelovvedh. Eengkelh jïh åålmege elmierïjhkesne jïh eatnamisnie altese gielhtie dov hearlohkevoetem heevehtieh. Dejgujmie aktine mijjieh aaj datnem heevehtibie:\n\n{{r}}G |{{/r}} laavloeh | Aejlies, aejlies, aejlies hov Jupmele Sebaot. Altese hearlohkevoete abpe eatnemem deavhta. Hosianna jallatjommesisnie. Bueriesjugniedassh altasasse gie Jupmelen nommesne båata. Hosianna jallatjommesisnie.\n\n{{r}}L |{{/r}} Mijjen Åejvie, Jeesus Kristuse, dan jïjjen goh beahtasovvi,\ndellie laejpiem vaalta, gæjhta, dam tsååpke, learoehkidie vadta jïh jeahta:Vaeltede daam, byöpmedidie! Daate mov åedtjie mij dijjese vadtasåvva. Darjode daam guktie mannem mujhtede.\n\nGåasem aaj vaalta beapmoej mænngan, gæjhta, vadta jïh jeahta:Jovkede gaajhkesh daestie.\nDaate gåase lea orre sjïehtedimmie mov vïrrine,\nmij edtja galkedh dijjen sådtoej gielhtie.\nGosse daam jovkede, mujhtede mannem.\n\nÅålmege maahta daelie jiehtedh jaahkoe mysterijume lea.\n\n{{r}}L |{{/r}} Jaahkoen mysterijume stoere.\n{{r}}G |{{/r}} Kristuse jeemi. Kristuse tjuedtjieli. Kristuse vihth bååstide båata. Earoe Kristusasse juktie gieriesvoete jaemiedistie veaksahkåbpoe.\n\n{{r}}L/KL |{{/r}} lååvle jallh jeahta | Åårmegs Jupmele, aavosne heevehtibie daam maalestahkem jïh gijhtebe dov Baernien ellies sjïeledimmien åvteste, jïh jaehkebe dov Baernie goh vitnije jaemiedistie tjuedtjielamme jïh bæjjese Aalman vualkeme, jïh mijjieh vuertebe edtja hearlohkevoetine bååstide båetedh. Dutnjien rohkelibie: Dievhtieh mijjem dov Voejkeninie jïh gieriesvoetine guktie maehtebe Kristusem vuejnedh gosse almetjem vuejnebe gie nealoeminie jïh gajhkelovveminie. Ööhpehth mijjem sinsitniem iehtsedh guktie Kristuse mijjem eahtseme, jïh baajh mijjem dov ellies rïjhkese tjåanghkenidh.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-42",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Mijjen Aehtjie",
						"text": "{{r}}L/KL |{{/r}} lååvle jallh jeahta | Jupmele, dievhtieh mijjem dov Voejkeninie. Faerhmesth mijjem guktie gieries tjidtjie maanide faerhmeste. Lutnjesth viesjies almetjidie jïh bïepmehth buerie vadtesigujmie dejtie gïeh nealkoeminie.\n\n{{r}}G |{{/r}} Mijjen Aehtjie guhte leah Elmierïjhkesne.\nBaajh dov nommem aejliestovvedh. Baajh dov rïjhkem båetedh.\nBaajh dov syjhtedem eatnamisnie sjïdtedh guktie Elmierïjhkesne.\nVedtieh mijjese daan biejjien mijjen fïerhten beajjetje laejpiem.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-43",
						"type": "tekst",
						"heading": "Luejhtieh mijjeste maam mijjieh meadteme",
						"instr": "",
						"text": "guktie mijjieh luejhtebe dejstie guhth mijjese meadteme.\nAellieh luejhtieh mijjem gïehtjelimmiej sïjse,\nvaallah vaarjelh mijjem bahheste.\nJuktie rïjhke lea dov, faamoe jïh earoe ihkuven aajkan. Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-44",
						"type": "tekst",
						"heading": "*22 Aejlies maalestahke",
						"instr": "@NOTAT Jupmelen raeffie PAX\n@NOTAT Laejpiem tsåapkodh\n@NOTAT Jupmelen Laampe AGNUS DEI\n@NOTAT Maalestahke\n@NOTAT Gyjhtelasse",
						"text": "Åålmege tjåådtje goske almetjh edtjieh maalestahkem dåastoehtidh.\n\n{{r}}L |{{/r}} jeahta | Jupmelen raeffie dijjine.\nÅå| Jupmelen raeffie datnine.\n\nLiturge jallh klahkeliturge maahta lissiehtidh:\n{{r}}L/KL |{{/r}} Fïereguhte maahta gïetem raeffesne geelkedh.\nAlmetjh gïetem gelkieh jïh jiehtieh «Jupmelen raeffie» jallh maam joem mij sjeahta.\n\nLiturge maahta dellie jiehtedh:\n{{r}}L |{{/r}} Laejpie maam tsåapkobe, Kristusen åedtjiem vadta. Juktie akte laejpie lea, mijjieh akte åedtjie.\n\n{{r}}G |{{/r}} laavloeh | Jupmelen laampe, datne gie gaajhkh almetji sådtoeh guadtah,\naarmodh mijjem!\nJupmelen laampe, datne gie gaajhkh almetji sådtoeh guadtah,\naarmodh mijjem!\nJupmelen laampe, datne gie gaajhkh almetji sådtoeh guadtah,\nvedtieh mijjese raeffiem!\n\nLiturge maahta daelie jallh „Agnus Dei“-n åvtelen, jiehtedh:\n{{r}}L |{{/r}} Båetede juktie gaajhke riejries.\n\nSaalme jallh tjïerte-laavlome jallh sjïehteles musihke maalestahken mearan.\nDïhte gie laejpiem jïh vijnem vadta, jeahta:\n\nKristusen åedtjie dutnjien vadtasovveme. Kristusen vïrre dutnjien vadtasovveme.\n\nMaahta aaj naemhtie jiehtedh: Daate Jeesusen åedtjie. Daate Jeesusen vïrre.\n\nJis gie akt båata jïh vuesehte satne ij sïjhth laejpiem jïh vijnem dåastoehtidh, bueriesjugniedåvva. Dïhte gie laejpiem guadta, gïetem almetjen nïlle beaja jallh kroessem tjaala mearan bueriesjugnede.\n\nLiturge maahta naemhtie jiehtedh:\nJupmele datnem bueriesjugnede jïh vaarjele jïh datnem ihkuve jieliedasse vaedtsehte.\n\nMaalestahken mænngan:\n{{r}}L |{{/r}} jeahta | Jeesus Kristuse gie kroessese noeresovvi jïh jaemiedistie tjuedtjieli, jïjtse åedtjiem jïh vïrrem gaajhki mijjen sådtoej dïehre vadteme.\n{{r}}G |{{/r}} (jallh L) | Mijjem nænnoste jïh viehkehte rïekteslaakan jaehkedh guktie ihkuve jieledem åadtjobe.\n{{r}}L |{{/r}} Jupmelen raeffie dijjine.\n\n23 Aejlies maalestahken galhkeme\nLiturge aalterem sjyöke. Gåasem jïh gaeriem lijnine gaptjede.\n\nLiturge jallh klahkeliturge maahta jiehtedh jallh laavlodh:\n{{r}}L/KL |{{/r}} Gijhtebe jïh rohkelibie.\n\nLiturge jallh klahkeliturge maahta daam rohkelassem laavlodh:\n{{r}}L/KL |{{/r}} Elmierïjhken Aehtjie, datnem gijhtebe dov buerie vadtesi åvteste.\nVaarjelh mijjem daaj vadtesigujmie, ektedh mijjem dov gieriesvoetine jïh nænnosth mijjen håhkoem ihkuve jieleden bïjre dov Baernien, Jeesus Kristusen gielhtie.\nÅå| Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-45",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L/KL |{{/r}} Vijsiesvoeten Jupmele, datnem gijhtebe maalestahken gïengele tjeakoesvoeten åvteste: Laejpiem maam libie tsööpkeme, aktelaaketje lea. Dov Baernie jïjtse hïegkem vedtieji gaajhken veartenen åvteste jïh gaajhki almetjetjïerti åvteste. Datnem birrebe:\n{{r}}G |{{/r}} jallh L/KL |\nBaajh mijjem govledh tjåarvehtassem maam datne govleme, vuejnedh dam neavroem maam datne vuajneme jïh lïhkesadtjem iehtsedh guktie jïjtjemem iehtebe.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-46",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L/KL |{{/r}} Åårmegs Jupmele, datnem gijhtebe, datne gie laejpine jïh vijnine mijjese Jeesus Kristusen vitnemem jaemeden vuestie vadteme. Datnem birrebe:\n{{r}}A |{{/r}} jallh L/KL | Nænnosth mijjem dov Voejkeninie guktie veartanisnie vïhnesjibie jïh dïenesjibie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-47",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L/KL |{{/r}} Gaerteles Jupmele, dov maanine sjïdtimh gosse lååvkesovvimh, jïh dov rïjhkem åadtjobe eerpedh. Maalestahken åvteste gijhtebe. Gosse dov åedtjiem jïh vïrrem åadtjobe, dellie datne sådtode mijjeste luajhtah jïh mijjen jaahkoem dov dååjvehtasside nænnosth.\n{{r}}G |{{/r}} jallh L/KL | Nænnosth mijjem dov Voejkeninie guktie veartanisnie vïhnesjibie jïh dïenesjibie.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					}
				]
			},
			{
				"title": "Åålmege seedtesåvva",
				"items": [
					{
						"id": "i-mwrtxqta-48",
						"type": "tekst",
						"heading": "*24 Saalme",
						"instr": "",
						"text": "Saalme daelie jallh gosse Postludijume /Prosesjovne, lïhtsege 27.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-49",
						"type": "tekst",
						"heading": "*25 Bueriesjugniedasse",
						"instr": "@NOTAT Heevehtimmie BENEDICAMUS",
						"text": "Fïereguhte maahta kroessem jïjtse mïelkese tjaeledh.\nLiturge maahta naemhtie aelkedh:\n\n{{r}}L/KL |{{/r}} lååvle jallh jeahta | Jupmelem heevehtibie.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-50",
						"type": "tekst",
						"heading": "Åå Jupmelem heevehtibie. Halleluja. Halleluja. Halleluja",
						"instr": "",
						"text": "",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-51",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Jupmele datnine SALUTATIO",
						"text": "{{r}}L |{{/r}} lååvle jallh jeahta | Jupmele dijjine aktesne.\nÅå | Jïh Jupmele datnine aaj!\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-52",
						"type": "tekst",
						"heading": "jallh",
						"instr": "@NOTAT Bealloe tjuaja 3x3 aejkien",
						"text": "{{r}}L |{{/r}} jeahta | Dåastoehtidie bueriesjugniedassem.\n\n{{r}}L |{{/r}} Jupmele datnem bueriesjugnede jïh datnem vaarjele.\nJupmele jïjtse ååredæjjine dutnjien tjuavka jïh datnem aarmode.\nJupmele jïjtse ååredæjjam dov gåajkoe jarkoe jïh dutnjien raeffiem vadta! \n\nÅålmege maahta laavlodh:\nÅå| Aamen. Aamen. Aamen.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-53",
						"type": "tekst",
						"heading": "*26 Åålmege seedtesåvva",
						"instr": "",
						"text": "Jis åålmege tjahkesje gosse postludijume, dellie åålmege postludijumen mænngan seedtesåvva.\n\nLiturge jallh klahkeliturge maahta jiehtedh:\n{{r}}L/KL |{{/r}} Raeffesne vaedtsebe,\n{{r}}G |{{/r}} Jeesus Kristusen nommesne.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-54",
						"type": "tekst",
						"heading": "jallh",
						"instr": "",
						"text": "{{r}}L/KL |{{/r}} Vaedtsede raeffesne. Dïenesjidie Åejviem aavosne.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqta-55",
						"type": "tekst",
						"heading": "*27 Postludijume/Prosesjovne",
						"instr": "",
						"text": "Åålmege maahta prosesjovnem olkese dåeriedidh. Jis ij postludijume leah, dellie åålmege maahta saalmem laavlodh gosse olkese vaadtsa.\nGærhkoe maahta gyrhkesjimmien mænngan rïhpeldahkesne årrodh guktie almetjh maehtieh raeffesne tjahkasjidh.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					}
				]
			}
		],
