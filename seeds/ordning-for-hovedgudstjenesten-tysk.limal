{
	"liturgiFormat": 1,
	"kind": "template",
	"data": {
		"id": "ordning-for-hovedgudstjenesten-tysk",
		"name": "Ordning for hovedgudstjenesten (Tysk)",
		"malForm": "Tysk",
		"liturgiType": "gudstjeneste",
		"kanGudstjeneste": true,
		"sections": [
			{
				"title": "Uten tittel",
				"items": [
					{
						"id": "i-mwrtxr6c-0",
						"type": "tekst",
						"heading": "Ordnung für den",
						"instr": "",
						"text": "",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
