					{
						"id": "l-57",
						"type": "tekst",
						"heading": "Lovprisning",
						"text": "{{r}}L |{{/r}} La oss prise Herren.\n{{r}}M |{{/r}} Gud være lovet. Halleluja. Halleluja. Halleluja.",
						"instr": "",
