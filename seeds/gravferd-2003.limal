					{
						"id": "gf-15",
						"type": "instruks",
						"heading": "15 Postludium",
						"text": "",
						"instr": "Før postludiet kan det fremføres et musikkinnslag, vokalt eller instrumentalt. Under postludiet bæres kisten ut.",
