					},
					{
						"id": "i-mwrtxqmt-54",
						"type": "tekst",
						"heading": "Oppalaš ráidu 3",
						"instr": "",
						"text": "{{r}}ML |{{/r}} ja Buo lávlot\n{{r}}ML |{{/r}} Bassi, bassi, bassi lea Hearrá Ipmileamet.\nBuo | Geardun: Bassi, bassi, bassi lea Hearrá Ipmileamet.\n{{r}}ML |{{/r}} Don leat almmi ja eatnama Hearrá.",
