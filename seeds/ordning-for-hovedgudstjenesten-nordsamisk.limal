					},
					{
						"id": "i-mwrtxqmu-108",
						"type": "tekst",
						"heading": "Lávlojuvvo dahje celkojuvvo",
						"instr": "@NOTAT Eahkedismálisliturgiija joatká Hearrá rohkosiin",
						"text": "{{r}}L |{{/r}} Čieŋal lea oskku čiegusvuohta\nBuo | Kristus jámii. Kristus bajásčuožžilii. Kristus boahtá fas. Sutnje lehkos gudni ráhkisvuođa ovddas mii lea gievrrat go jápmin.\n{{r}}L/ML |{{/r}} cealká | Ovttas buot du mánáiguin rohkadallat mii dan rohkosa maid du Bárdni lea oahpahan midjiide.\n",
						"alts": [],
