					},
					{
						"id": "i-mwrtxqmt-86",
						"type": "tekst",
						"heading": "Buo Geardun",
						"instr": "",
						"text": "{{r}}ML |{{/r}} Buressivdniduvvon lehkos son guhte boahtá Hearrá nammii.",
