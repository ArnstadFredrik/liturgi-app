					},
					{
						"id": "i-mwrtxqmt-56",
						"type": "tekst",
						"heading": "Buo geardun",
						"instr": "",
						"text": "{{r}}ML |{{/r}} Don leat vuolggahan midjiide Jesus Kristusa, du Bártnát.",
