					},
					{
						"id": "i-mwrtxqmu-102",
						"type": "tekst",
						"heading": "Oppalaš ráidu 3",
						"instr": "",
						"text": "{{r}}ML |{{/r}} ja Buo lávlot\n{{r}}ML |{{/r}} Bassi, bassi, bassi lea Hearrá Ipmileamet.\nBuo | Geardun: Bassi, bassi, bassi, lea Hearrá ipmileamet.\n{{r}}ML |{{/r}} Don leat almmi ja eatnama Hearrá.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqmu-103",
						"type": "tekst",
						"heading": "Buo Geardun",
						"instr": "",
						"text": "{{r}}ML |{{/r}} Don leat hearvásvuohta ja veagalaš ja stuoris.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxqmu-104",
						"type": "tekst",
						"heading": "Buo Geardun",
						"instr": "",
						"text": "{{r}}ML |{{/r}} Don leat vuolggahan midjiide Jesus Kristusa, du Bártni.",
						"alts": [],
