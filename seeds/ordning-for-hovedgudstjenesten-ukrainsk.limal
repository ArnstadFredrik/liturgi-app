					},
					{
						"id": "i-mwrtxrj6-110",
						"type": "tekst",
						"heading": "*24 Гімн",
						"instr": "@NOTAT Славослів’я BENEDICAMUS",
						"text": "Цей гімн можна перенести у частину 27 Постлюдія / Останній спів\n*25 Благословення\nЦе благословення використовують не тільки в Урочистій Месі, а й в інших службах.\nБлагословення проказують або співають.\nКожен з вірних приймає благословення, чинячи хресне знамення.\n\nБлагословенню передує такий вступ:\n\nС/СП співає чи каже | Господа славімо.\nУ | Слава Богу. Алілуя. Алілуя. Алілуя.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxrj6-111",
						"type": "tekst",
						"heading": "або",
						"instr": "@NOTAT Вітання SALUTATIO",
						"text": "С співає чи каже | Господь з вами.\nВ | І з духом твоїм.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxrj6-112",
						"type": "tekst",
						"heading": "або",
						"instr": "@NOTAT Дзвін пробиває дев’ять разів, три серії по три удари.",
						"text": "С каже | Прийміть благословення.\n\nС | Нехай Господь благословить вас і буде з вами.\nНехай лик Господній осяє ваше життя милістю.\nНехай благодать Господня зійде на вас і наповнить душі миром. \n\nВірні співають чи промовляють:\nВ | Амінь. Амінь. Амінь.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxrj6-113",
						"type": "tekst",
						"heading": "* 26 Відпуст",
						"instr": "",
						"text": "Якщо після цього на час постлюдії вірні залишаються сидіти, слова відпусту можна промовити вже після постлюдії.\n\nМожуть мовитися такі слова:\nС/СП | Ідіть з миром,\nУ | в ім’я Господа Ісуса Христа.\n",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					},
					{
						"id": "i-mwrtxrj6-114",
						"type": "tekst",
						"heading": "або",
						"instr": "",
						"text": "С/СП | Ідіть з миром. Служіть Господу радо всім своїм життям.\n27 Постлюдія / Останній спів\nПід час останнього співу богослужіння вірні можуть слідувати за процесією. Замість постлюдії вірні можуть заспівати гімн.\nПісля служби церква деякий час залишається відчинена для мовчазної молитви і роздумів про духовне.\nОбов’язки диякона можуть здійснюватися під час зібрань громади, відвідування домівок, молитов й інших парафіяльних повинностей.",
						"alts": [],
						"selAlt": 0,
						"enabled": true,
						"optional": false,
						"salmeNr": "",
						"salmeTittel": ""
					}
				]
			}
