{
  "name": "liturgi-app",
  "private": true,
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnstadFredrik/liturgi-app.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "no.arnstad.liturgi",
    "productName": "Liturgi",
    "icon": "electron/icons/liturgi-512.png",
    "files": [
      "build/**/*",
      "electron/**/*",
      "electron/icons/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "liturgi",
        "name": "Liturgi-fil",
        "description": "Gudstjeneste lagret i Liturgi-appen",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "svelte": "^5.25.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "church-year": "^0.2.61",
    "docx": "^9.0.0",
    "pptxgenjs": "^4.0.1",
    "svelte-sonner": "^1.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}