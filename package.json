{
  "name": "liturgi-app",
  "private": true,
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnstadFredrik/liturgi-app.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "VITE_DEV_MODE=1 vite build --mode development",
    "electron:dev": "npm run build:dev && electron . --remote-debugging-port=9230",
    "preview": "vite preview",
    "electron": "electron . --remote-debugging-port=9230",
    "app:mac": "node scripts/skriv-byggnr.mjs && vite build && electron-builder --mac",
    "test": "node --test \"tests/enhet/*.test.mjs\"",
    "test:royk": "npm run build && node tests/royktest.mjs"
  },
  "build": {
    "appId": "no.arnstad.liturgi",
    "productName": "Liturgi",
    "icon": "electron/icons/liturgi-512.png",
    "files": [
      "build/**/*",
      "electron/**/*",
      "electron/icons/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "liturgi",
        "name": "Liturgi-fil",
        "description": "Gudstjeneste lagret i Liturgi-appen",
        "role": "Editor"
      },
      {
        "ext": "limal",
        "name": "Liturgi-mal",
        "description": "Gudstjenestemal lagret i Liturgi-appen",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icons/liturgi.icns"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/liturgi.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Liturgi-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icons/liturgi-512.png",
      "category": "Office",
      "artifactName": "Liturgi-${version}-${arch}.${ext}"
    },
    "deb": {
      "category": "Office"
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "svelte": "5.38.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "church-year": "^0.2.61",
    "docx": "^9.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "svelte-sonner": "^1.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
